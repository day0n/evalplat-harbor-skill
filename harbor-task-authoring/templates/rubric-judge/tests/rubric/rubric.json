 "criteria": [
  {
   "id": "R01",
   "description": "写出 2025 年末资产负债率为 65.00%（绝对误差不超过 0.01 个百分点），与“2025”“资产负债率”出现在同一行。",
   "tag": "内容质量-数值与计算准确性",
   "criterion_type": "Objective",
