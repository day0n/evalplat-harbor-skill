   "type": "binary",
   "weight": 20,
   "method": "code",
   "polarity": "positive",
   "check": {"kind": "number", "value": 65.0, "tolerance": 0.01, "unit": "%", "context": ["2025", "资产负债率"]}
  },
  {
   "id": "R02",
   "description": "注明 65.00% 的计算依据：负债合计 78,000 万元 ÷ 资产总计 120,000 万元，且取自《财务摘要》2025-12-31 列。",
   "tag": "内容质量-事实忠实性",
   "criterion_type": "Objective",
   "criterion_necessity": "Explicit",
   "type": "binary",
   "weight": 15,
   "method": "llm",
   "polarity": "positive"
  },
  {
   "id": "R03",
   "description": "明确给出结论“2025 年末资产负债率超过 60%”；只写“待核”、不下结论或结论与 65.00% 矛盾均不满足。",
   "tag": "内容质量-结论正确性",
   "criterion_type": "Objective",
   "criterion_necessity": "Explicit",
   "type": "binary",
   "weight": 25,
   "method": "llm",
   "polarity": "positive",
   "requires": ["R01"]
